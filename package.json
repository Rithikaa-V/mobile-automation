{
  "name": "flutter-app-mobile-automation",
  "version": "1.0.0",
  "private": true,
  "description": "WebdriverIO and Appium end-to-end tests for a Flutter field-operations app",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "test": "wdio run ./wdio.conf.ts",
    "test:common": "wdio run ./wdio.conf.ts --spec test/specs/common/common.spec.ts",
    "test:cro": "wdio run ./wdio.conf.ts --spec test/specs/cro/cro.spec.ts",
    "test:bm": "wdio run ./wdio.conf.ts --spec test/specs/bm/bm.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@wdio/allure-reporter": "^9.27.2",
    "@wdio/appium-service": "^9.27.2",
    "@wdio/cli": "^9.27.2",
    "@wdio/globals": "^9.27.2",
    "@wdio/local-runner": "^9.27.2",
    "@wdio/mocha-framework": "^9.27.2",
    "@wdio/spec-reporter": "^9.27.2",
    "appium-flutter-finder": "^0.2.0",
    "appium-uiautomator2-driver": "^7.6.0",
    "expect-webdriverio": "^5.6.7",
    "typescript": "^5.9.3"
  }
}
